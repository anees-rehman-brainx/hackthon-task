# Place this file next to `package.json` (backend repo root). Nest loads it via ConfigModule.

# Server (default 5000 if PORT omitted)
PORT=5000
NODE_ENV=development

# OpenAI — required for /api/brief/*
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-preview

# Optional: override `.env` path (absolute or relative to cwd when set from shell)
# DOTENV_CONFIG_PATH=

# Optional: e.g. http://localhost:5173 — leave empty to mirror request Origin (local dev)
CORS_ORIGIN=
